<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <!-- rectangle where text is going -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userBubbleCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_user_bubble"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.88">

        <TextView
            android:id="@+id/userMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/raleway_bold"
            android:text="What is the protocol for Adverse Drug Reactions?"
            android:textColor="#212121"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- floating pill -->
    <TextView
        android:id="@+id/userPillBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_pill_badge_blue"
        android:elevation="6dp"
        android:fontFamily="@font/raleway_bold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="5dp"
        android:text="Staff"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/userBubbleCard"
        app:layout_constraintStart_toStartOf="@+id/userBubbleCard"
        app:layout_constraintTop_toTopOf="@+id/userBubbleCard" />

</androidx.constraintlayout.widget.ConstraintLayout>