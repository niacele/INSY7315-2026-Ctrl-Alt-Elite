@model Digital_Handbook_Portal.Models.Policy

@{
    ViewData["Title"] = "Create Policy";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h4 class="form-section-title mb-0">Create New Policy</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Inpatient Fall Prevention Protocol" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="categoryId" class="form-label fw-semibold">Category</label>
                                <select asp-for="categoryId" asp-items="ViewBag.Categories" class="form-select">
                                    <option value="">-- Select Policy Category --</option>
                                </select>
                                <span asp-validation-for="categoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="specificCategory" class="form-label fw-semibold">Specific Category (Optional)</label>
                                <input asp-for="specificCategory" class="form-control" placeholder="e.g. Emergency Care" />
                                <span asp-validation-for="specificCategory" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="doctorId" class="form-label fw-semibold">Linked Doctor (Optional)</label>
                            <select asp-for="doctorId" asp-items="ViewBag.Doctors" class="form-select">
                                <option value="">-- None (General Policy) --</option>
                            </select>
                            <span asp-validation-for="doctorId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="contentSummary" class="form-label fw-semibold"></label>
                            <textarea asp-for="contentSummary" class="form-control" rows="4" placeholder="Brief 1-2 sentence overview for mobile search..."></textarea>
                            <span asp-validation-for="contentSummary" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">Document Source</label>

                            <div class="btn-group w-100 mb-3" role="group" aria-label="Resource Source Selector">
                                <input type="radio" class="btn-check" name="resourceTypeToggle" id="typePdf" value="pdf" checked autocomplete="off">
                                <label class="btn btn-outline-primary" for="typePdf">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> Upload PDF Document
                                </label>

                                <input type="radio" class="btn-check" name="resourceTypeToggle" id="typeWeb" value="web" autocomplete="off">
                                <label class="btn btn-outline-primary" for="typeWeb">
                                    <i class="bi bi-globe me-1"></i> External Website / Link
                                </label>
                            </div>

                            <div id="pdfUploadContainer">
                                <label class="form-label text-muted small">Choose PDF File</label>
                                <input type="file" id="pdfFileInput" name="pdfFile" class="form-control" accept=".pdf" />
                                <div class="form-text">Upload a document directly into hospital cloud storage.</div>
                            </div>

                            <div id="webLinkContainer" class="d-none">
                                <label class="form-label text-muted small">Website URL</label>
                                <input asp-for="fileUrl" id="webUrlInput" class="form-control" placeholder="https://www.example.com/guidelines" />
                                <div class="form-text">Enter a direct website address or external portal link.</div>
                                <span asp-validation-for="fileUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-hospital-primary px-4">Create Policy</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}